{
  "name": "Quill Standard",
  "type": "dark",
  "colors": {
    "editor.background": "#1e1e1e",
    "editor.foreground": "#d4d4d4"
  },
  "tokenColors": [
    {
      "scope": "comment.line.number-sign.quill",
      "settings": {
        "foreground": "#6A9955",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.control.quill",
        "keyword.control.import.quill"
      ],
      "settings": {
        "foreground": "#C586C0"
      }
    },
    {
      "scope": "storage.type.quill",
      "settings": {
        "foreground": "#DCDCAA"
      }
    },
    {
      "scope": [
        "constant.numeric.integer.quill",
        "constant.numeric.float.quill"
      ],
      "settings": {
        "foreground": "#FFA500"
      }
    },
    {
      "scope": "string.quoted.double.quill",
      "settings": {
        "foreground": "#4FC1FF"
      }
    },
    {
      "scope": "constant.character.escape.quill",
      "settings": {
        "foreground": "#D7BA7D"
      }
    },
    {
      "scope": "entity.name.namespace.quill",
      "settings": {
        "foreground": "#4EC9B0"
      }
    },
    {
      "scope": [
        "entity.name.function.member.quill",
        "entity.name.function.quill"
      ],
      "settings": {
        "foreground": "#DCDCAA"
      }
    },
    {
      "scope": [
        "variable.other.quill",
        "variable.other.member.quill"
      ],
      "settings": {
        "foreground": "#9CDCFE"
      }
    },
    {
      "scope": "punctuation.accessor.quill",
      "settings": {
        "foreground": "#D4D4D4"
      }
    },
    {
      "scope": [
        "punctuation.separator.quill",
        "punctuation.separator.key-value.quill",
        "punctuation.separator.comma.quill",
        "punctuation.terminator.quill"
      ],
      "settings": {
        "foreground": "#808080"
      }
    },
    {
      "scope": "keyword.operator.quill",
      "settings": {
        "foreground": "#D4D4D4"
      }
    }
  ]
}