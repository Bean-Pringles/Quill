{
  "scopeName": "source.quill",
  "name": "Quill",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#import-statement" },
    { "include": "#member-call" },
    { "include": "#member-access" },
    { "include": "#keyword" },
    { "include": "#type" },
    { "include": "#number" },
    { "include": "#function-call" },
    { "include": "#operator" },
    { "include": "#punctuation" },
    { "include": "#variable" }
  ],
  "repository": {

    "comment": {
      "name": "comment.line.number-sign.quill",
      "match": "#.*$"
    },

    "string": {
      "name": "string.quoted.double.quill",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.quill",
          "match": "\\\\."
        }
      ]
    },

    "import-statement": {
      "comment": "Matches: import <libname>  — highlights the keyword and the lib name separately",
      "match": "\\b(import)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.control.import.quill" },
        "2": { "name": "entity.name.namespace.quill" }
      }
    },

    "member-call": {
      "comment": "Matches: libname.method(  — e.g. os.exit(0) or rand.randint(1,4)",
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(\\.)([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()",
      "captures": {
        "1": { "name": "entity.name.namespace.quill" },
        "2": { "name": "punctuation.accessor.quill" },
        "3": { "name": "entity.name.function.member.quill" }
      }
    },

    "member-access": {
      "comment": "Matches: libname.property  (no parens) — e.g. os.something used as a value",
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(\\.)([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "entity.name.namespace.quill" },
        "2": { "name": "punctuation.accessor.quill" },
        "3": { "name": "variable.other.member.quill" }
      }
    },

    "keyword": {
      "name": "keyword.control.quill",
      "match": "\\b(print|let|const|input|swap)\\b"
    },

    "type": {
      "name": "storage.type.quill",
      "match": "\\b(i32|i64|f32|f64|bool|string|int|float)\\b"
    },

    "number": {
      "patterns": [
        {
          "name": "constant.numeric.float.quill",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.quill",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },

    "function-call": {
      "comment": "Any bare identifier followed by ( that wasn't caught by member-call",
      "name": "entity.name.function.quill",
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
    },

    "operator": {
      "name": "keyword.operator.quill",
      "match": "==|!=|<=|>=|&&|\\|\\||[+\\-*/%=!<>]"
    },

    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.key-value.quill",
          "match": ":"
        },
        {
          "name": "punctuation.separator.comma.quill",
          "match": ","
        },
        {
          "name": "punctuation.terminator.quill",
          "match": ";"
        }
      ]
    },

    "variable": {
      "comment": "Plain identifiers that didn't match anything above",
      "name": "variable.other.quill",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
    }

  }
}